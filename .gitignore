# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# IDE and operating system clutter
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Private source photos and generated processed images. Keep placeholder files.
/dataset/*
!/dataset/.gitkeep
!/dataset/*/
/dataset/*/*
!/dataset/*/.gitkeep
!/dataset/processed/
/dataset/processed/**
!/dataset/processed/*/
!/dataset/processed/*/.gitkeep

# Private original and processed face images
/dataset/**/*.jpg
/dataset/**/*.jpeg
/dataset/**/*.png
/dataset/**/*.webp
/dataset/**/*.bmp
/dataset/**/*.tif
/dataset/**/*.tiff
/dataset/**/*.heic

# Private biometric data and generated artifacts
/dataset/**/*.npy
/dataset/**/*.npz
/dataset/**/*.pkl
/dataset/**/*.pickle
/dataset/**/*.pt
/dataset/**/*.pth

# Local diagnostic reports and contact sheets
/reports/

